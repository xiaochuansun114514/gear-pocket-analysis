<event>
<eventItme type="touchmonitor">
f(st_eA == 2)
{
s-(st_rX, sss.rX, x)
s-(st_rY, sss.rY, y)
f(sss.rXY == true || x&gt;80 || x&lt;-80 || y&gt;80 || y&lt;-80)
{
sss rXY = true
s-(40, st_rX)
s-(80, st_rY)
us(sss.xfc, "x", st_rX)
us(sss.xfc, "y", st_rY)
uxf(sss.xfc)
}
}
else f(st_eA == 0)
{
sss rX = st_rX
sss rY = st_rY
sss rXY = false
}
</eventItme>
<eventItme type="clicki">
gvs(sss.xfc, sto.2, xf)
f(sss.flags ==0)
{
sss flags = 1
us(xf, "visibility", "visible")
}
else
{
sss flags = 0
us(xf, "visibility", "gone")
}
ug(sss.xfc, "x", x)
ug(sss.xfc, "y", y)
s w = -2
s h = -2
s type = 0
s gravity = "top|left"
s format = 0
uxf(sss.xfc, "set", x, y, w, h, type, gravity, sss.flags, format)
</eventItme>
</event>
</View>
